# 그대로 복사해서 .env 로 쓰면 docker-compose.yml 의 db 컨테이너와 맞는다.
DATABASE_URL=postgresql+asyncpg://pkm:pkm@localhost:5433/pokemon_battle

# 프론트 개발 서버 주소 (CORS 허용 목록, 콤마 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 배포 환경에서 Vercel 미리보기처럼 URL 이 매번 바뀌는 오리진을 받으려면 패턴을 쓴다.
# 로컬 개발에선 필요 없다.
# CORS_ORIGIN_REGEX=^https://pokemon-card-battle-[a-z0-9]+-davids-projects-[a-z0-9]+\.vercel\.app$

# 라운드 제한시간(초). 0 이면 타이머 비활성화
ROUND_TIMEOUT_SECONDS=30
